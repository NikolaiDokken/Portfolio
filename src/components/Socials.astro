---
const socials = [
  { name: "github", url: "https://github.com/NikolaiDokken" },
  { name: "linkedin", url: "https://www.linkedin.com/in/nikolaidokken" },
];

const email = { user: "nikolaidokken", domain: "live.no" };
---

<ul class="socials">
  {
    socials.map(({ name, url }) => (
      <li>
        <a href={url}>[{name}]</a>
      </li>
    ))
  }
  <li>
    <a id="email-link" data-user={email.user} data-domain={email.domain} href="#">[email]</a>
  </li>
</ul>

<script>
  const link = document.getElementById("email-link") as HTMLAnchorElement;
  const { user, domain } = link.dataset;
  link.href = `mailto:${user}@${domain}`;
</script>

<style>
  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .socials a {
    text-decoration: none;
  }
</style>
