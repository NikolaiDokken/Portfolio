---
import Sun from "./icons/Sun.astro";
import Moon from "./icons/Moon.astro";
---

<button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
  <span class="icon-sun"><Sun /></span>
  <span class="icon-moon"><Moon /></span>
</button>

<script>
  const btn = document.getElementById("theme-toggle")!;

  function current(): "light" | "dark" {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function apply(theme: "light" | "dark") {
    if (theme === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  }

  btn.addEventListener("click", () => {
    apply(current() === "dark" ? "light" : "dark");
  });
</script>

<style>
  #theme-toggle {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  #theme-toggle:hover {
    opacity: 1;
  }

  /* Light theme: show moon (click to go dark), hide sun */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: flex;
  }

  /* Dark theme: show sun (click to go light), hide moon */
  :global([data-theme="dark"]) .icon-sun {
    display: flex;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
</style>
