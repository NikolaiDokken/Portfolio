---
interface Props {
  /** Label for the last crumb (e.g. a post title) instead of its URL segment */
  currentLabel?: string;
}

const { currentLabel } = Astro.props;
const currentPath = Astro.url.pathname; // with leading '/'  e.g /cars/toyota/sedans/toyota-crown

const SEPARATOR = "/";

const getBreadcrumbs = (path: string) => {
  if (!path || path === SEPARATOR) return [];

  if (path.endsWith(SEPARATOR)) {
    path = path.slice(0, path.length - 1);
  }
  return path.split(SEPARATOR);
};

const breadcrumbs = getBreadcrumbs(currentPath);
---

{
  breadcrumbs.length > 0 && (
    <nav class="breadcrumb-row" aria-label="Breadcrumb">
      {breadcrumbs.map((breadcrumb, index) => (
        <div class="breadcrumb">
          {index > 0 && <p class="separator">{SEPARATOR}</p>}
          {index == breadcrumbs.length - 1 ? (
            currentLabel ? (
              <p aria-current="page">{currentLabel}</p>
            ) : (
              <p class="segment" aria-current="page">
                {decodeURIComponent(breadcrumb)}
              </p>
            )
          ) : (
            <a class="segment" href={breadcrumbs.slice(0, index + 1).join(SEPARATOR) || "/"}>
              {breadcrumb || "Home"}
            </a>
          )}
        </div>
      ))}
    </nav>
  )
}

<style>
  .breadcrumb-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 16px 0 24px 0;
  }

  .breadcrumb {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .segment {
    text-transform: capitalize;
  }

  .breadcrumb p {
    color: inherit;
  }

  .separator {
    margin: 0 16px 0 16px;
    font-weight: 700;
  }
</style>
