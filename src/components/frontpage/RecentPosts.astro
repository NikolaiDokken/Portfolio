---
import { getCollection } from "astro:content";
import PostList from "../posts/PostList.astro";

const posts = await getCollection("posts");
const recentPosts = posts.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()).slice(0, 4);
---

<div>
  <PostList posts={recentPosts} title="Recent Posts" />
  <a class="posts-link" href="/posts">{"See all posts >"}</a>
</div>

<style>
  .posts-link {
    font-size: 12px;
  }
</style>
