---
const { posts, title } = Astro.props;

const sortedPosts = posts.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---

<div>
  <h3>{title}</h3>
  <ul class="posts">
    {
      sortedPosts.map((post) => (
        <li>
          <a href={`/posts/${post.data.slug}`}>{post.data.title}</a>
          <span class="dots" />
          <span class="date">{post.data.publishedDate.toISOString().split("T")[0]}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .posts {
    list-style-type: none;
    list-style-position: inside;
    padding-left: 0;
    margin-bottom: 0;
  }

  .posts li {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 6px;
  }

  .dots {
    flex: 1;
    border-bottom: 1px dashed currentColor;
    opacity: 0.3;
    margin-bottom: 3px;
  }

  .date {
    white-space: nowrap;
    font-size: 12px;
    opacity: 0.6;
  }
</style>
