---
import { formatDate, getSortedPosts, postUrl, tagUrl } from "../../utils/posts";

interface Props {
  title?: string;
  /** Max posts to show; also adds a "See all" link when set */
  limit?: number;
  tag?: string;
}

const { title, limit, tag } = Astro.props;

const allPosts = await getSortedPosts();
const posts = (tag ? allPosts.filter((p) => p.data.tags.includes(tag)) : allPosts).slice(0, limit);
---

<div>
  {title && <h3>{title}</h3>}
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={postUrl(post.id)}>{post.data.title}</a>
          <span class="dots" />
          <span class="date">{formatDate(post.data.publishedDate)}</span>
        </li>
      ))
    }
  </ul>
  {
    limit !== undefined && (
      <a class="see-all" href={tag ? tagUrl(tag) : "/tags"}>
        {"See all >"}
      </a>
    )
  }
</div>

<style>
  .posts {
    list-style-type: none;
    list-style-position: inside;
    padding-left: 0;
    margin-bottom: 0;
  }

  .posts li {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 8px;
  }

  .dots {
    flex: 1;
    border-bottom: 1px dashed currentColor;
    opacity: 0.3;
    margin-bottom: 3px;
  }

  .date {
    white-space: nowrap;
    font-size: 12px;
    opacity: 0.6;
  }

  .see-all {
    font-size: 12px;
  }
</style>
