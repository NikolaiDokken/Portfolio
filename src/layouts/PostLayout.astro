---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import { formatDate, tagUrl } from "../utils/posts";

interface Props {
  frontmatter: CollectionEntry<"posts">["data"];
}

const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title} breadcrumbLabel={frontmatter.title}>
  <div class="meta-info">
    {
      frontmatter.tags.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map((tag) => (
            <a class="tag" href={tagUrl(tag)}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }
    <div class="meta-row">
      <span>By {frontmatter.author}</span>
      <span class="dots"></span>
      <span>{formatDate(frontmatter.publishedDate)}</span>
    </div>
  </div>
  <div class="content">
    <slot />
  </div>
</Layout>

<style>
  .meta-info {
    color: var(--color-ink-muted);
    font-size: small;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .dots {
    flex: 1;
    border-bottom: 1px dashed currentColor;
    opacity: 0.3;
    margin-bottom: 3px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .tag {
    font-size: 11px;
    background-color: var(--color-interactive-bg);
    color: var(--color-interactive-fg);
    padding: 2px 6px;
    text-decoration: none;
  }

  .content {
    margin-top: 24px;
    margin-bottom: 60px;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
