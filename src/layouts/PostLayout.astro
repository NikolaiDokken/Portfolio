---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title}>
  <div class="meta-info">
    <div>By {frontmatter.author}</div>
    <div>Published {frontmatter.publishedDate.toISOString().split("T")[0]}</div>
    {
      frontmatter.tags?.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map((tag: string) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  <div class="content">
    <slot />
  </div>
</Layout>

<style>
  .meta-info div {
    color: gray;
    font-size: small;
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .tag {
    color: gray;
    padding: 1px 4px;
    opacity: 0.8;
  }

  .content {
    margin-bottom: 32px;
  }
</style>
