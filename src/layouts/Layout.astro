---
import { Font } from "astro:assets";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

interface Props {
  pageTitle: string;
  description?: string;
  /** Label for the last breadcrumb, e.g. a post title instead of its slug */
  breadcrumbLabel?: string;
}

const SITE_NAME = "Nikolai Dokken";
const DEFAULT_DESCRIPTION = "Nikolai Dokken's portfolio and blog: projects, posts and experiments.";

const { pageTitle, description = DEFAULT_DESCRIPTION, breadcrumbLabel } = Astro.props;
const title = pageTitle === SITE_NAME ? SITE_NAME : `${pageTitle} | ${SITE_NAME}`;

const path = Astro.url.pathname;
const hasBreadcrumbs = path !== "/" && path.replace(/\/$/, "") !== "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/n_logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <!-- Runs before first paint to apply the saved/preferred theme without a flash -->
    <script is:inline>
      (function () {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved ?? (prefersDark ? "dark" : "light");
        if (theme === "dark") document.documentElement.setAttribute("data-theme", "dark");
      })();
    </script>
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: "400", style: "normal" }]} />
  </head>
  <body>
    <div class="center-container">
      {
        hasBreadcrumbs && (
          <div class="nav-row">
            <Breadcrumbs currentLabel={breadcrumbLabel} />
            <div class="toggle-slot">
              <ThemeToggle />
            </div>
          </div>
        )
      }
      <div class="title-row">
        <h1>{pageTitle}</h1>
        {!hasBreadcrumbs && <ThemeToggle />}
      </div>
      <slot />
    </div>
  </body>
</html>

<style>
  .center-container {
    width: 100%;
    margin: 0 auto;
    padding: 40px 24px 80px;
    box-sizing: border-box;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: 0 0 24px 0;
  }

  /* When breadcrumbs are present they push the toggle to the right naturally;
     without them the toggle still sits at the end of the row. */
  .nav-row :global(.breadcrumb-row) {
    flex: 1;
    margin: 0; /* breadcrumb-row has its own margin — reset it here */
  }

  .toggle-slot {
    flex-shrink: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 8px 0;
  }

  .title-row h1 {
    margin: 0;
  }

  @media (min-width: 768px) {
    .center-container {
      width: 60%;
      padding: 60px 0 100px;
    }
  }
</style>
