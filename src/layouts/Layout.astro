---
import { Font } from "astro:assets";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const { pageTitle } = Astro.props;

const path = Astro.url.pathname;
const hasBreadcrumbs = path !== "/" && path.replace(/\/$/, "") !== "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/n_logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Nikolai Dokken</title>
    <style>html { font-size: 14px; }</style>
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-space-mono" />
  </head>
  <body>
    <div class="center-container">
      {hasBreadcrumbs && (
        <div class="nav-row">
          <Breadcrumbs />
          <div class="toggle-slot">
            <ThemeToggle />
          </div>
        </div>
      )}
      <div class="title-row">
        <h1>{pageTitle}</h1>
        {!hasBreadcrumbs && <ThemeToggle />}
      </div>
      <slot />
    </div>
  </body>
</html>

<style>
  .center-container {
    width: 100%;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: 16px 0 24px 0;
  }

  /* When breadcrumbs are present they push the toggle to the right naturally;
     without them the toggle still sits at the end of the row. */
  .nav-row :global(.breadcrumb-row) {
    flex: 1;
    margin: 0;   /* breadcrumb-row has its own margin — reset it here */
  }

  .toggle-slot {
    flex-shrink: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 16px 0 8px 0;
  }

  .title-row h1 {
    margin: 0;
  }

  @media (min-width: 768px) {
    .center-container {
      width: 60%;
      padding: 0;
    }
  }
</style>
