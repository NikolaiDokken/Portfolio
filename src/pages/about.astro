---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import workExperience from "../data/work-experience.json";
import education from "../data/education.json";
import skills from "../data/skills.json";
import SkillBar from '../components/SkillBar.astro';
import Image from 'astro/components/Image.astro';
import Skydiving from "../assets/about.jpg";

interface Skill {
    skill: string;
    rating: number;
}
---

<BaseLayout title="About | Nikolai Dokken" description="About Nikolai Dokken's background and experience">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="This is me"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<Image
                    loading="eager"
					width="1553"
					height="873"
					src={Skydiving}
					alt="Nikolai Dokken tandem skydiving"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
                <p>
                    I'm a 25 year old from Oslo, Norway, who always had a passion for computers and video games. 
                    This led me down the path of programming and compuer science. I like programming as much as I like working with people. 
                    Other than that I really enjoy skiing, boating, disc golf and a cold beer with friends.
                </p>
			</section>
			<section>
				<h2 class="section-title">Experience</h2>
                <Experience experiences={workExperience} />
			</section>
			<section>
				<h2 class="section-title">Education</h2>
                <Experience experiences={education} />
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
                <div class="stack gap-2">
                    {skills.sort((a, b) => b.rating - a.rating).map((skill: Skill) => 
                        <SkillBar skill={skill.skill} rating={skill.rating} />
                    )}
                </div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
