---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Nikolai Dokken" description="About Nikolai Dokken's background and experience">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="This is me"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/about.jpg"
					alt="Nikolai Dokken tandem skydiving"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a 25 year old from Oslo, Norway, who always had a passion for computers and video games. 
						This led me down the path of programming and compuer science. I like programming as much as I like working with people. 
						Other than that I really enjoy skiing, boating, disc golf and a cold beer with friends.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Experience</h2>
				<div class="content">
					<p>Aug 2023-Now: Custom Software Engineer Senior Analyst @ Accenture</p>
					<p>Summer 2022: Summer Internship @ Bekk</p>
					<p>Summer 2021: Summer Internship @ Sopra Steria</p>
					<p>2020-2023: Software Developer @ WAID</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>2021-2023: Master in Computer Science at Norwegian University of Science and Technology</p>
					<p>Fall 2023: Extended Studies at University of California San Diego</p>
					<p>2018-2021: Bachelor in Computer Engineering at Norwegian University of Science and Technology</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>officia unde omnis</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
