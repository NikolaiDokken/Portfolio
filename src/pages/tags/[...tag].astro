---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/posts/PostList.astro";
import TagFilter from "../../components/tags/TagFilter.astro";
import { getTags } from "../../utils/posts";

export async function getStaticPaths() {
  const tags = await getTags();

  return [
    { params: { tag: undefined }, props: { tags } },
    ...tags.map((tag) => ({
      params: { tag },
      props: { tags },
    })),
  ];
}

const { tag } = Astro.params;
const { tags } = Astro.props;
---

<Layout pageTitle="Tags" description={tag ? `Posts tagged #${tag}.` : "All posts, filterable by tag."}>
  <TagFilter tags={tags} activeTag={tag} />
  <PostList tag={tag} title={tag ? `#${tag}` : "All"} />
</Layout>
